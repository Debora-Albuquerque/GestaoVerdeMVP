{
  "entities": {
    "ProducerProfile": {
      "title": "ProducerProfile",
      "description": "Perfil do produtor rural no cinturão verde de Mogi das Cruzes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID do usuário autenticado",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Nome do produtor",
          "minLength": 1,
          "maxLength": 100
        },
        "farmName": {
          "type": "string",
          "description": "Nome do sítio ou propriedade rural",
          "minLength": 2,
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "description": "Localidade no Alto Tietê",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de atualização no servidor"
        }
      },
      "required": ["uid", "displayName", "farmName", "region", "createdAt", "updatedAt"]
    },
    "Microarea": {
      "title": "Microarea",
      "description": "Unidade produtiva (canteiro, estufa ou talhão) monitorada pelo produtor.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do produtor proprietário",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Identificação da microárea (ex: Canteiro 1 - Repolho)",
          "minLength": 2,
          "maxLength": 80
        },
        "crop": {
          "type": "string",
          "description": "Cultura plantada na microárea",
          "minLength": 2,
          "maxLength": 50
        },
        "sector": {
          "type": "string",
          "description": "Tipo de ambiente produtivo",
          "minLength": 2,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["saudavel", "atencao", "critico"],
          "description": "Estado fitossanitário atual"
        },
        "latitude": {
          "type": "number",
          "description": "Latitude GPS da microárea"
        },
        "longitude": {
          "type": "number",
          "description": "Longitude GPS da microárea"
        },
        "lastReportSummary": {
          "type": "string",
          "description": "Resumo da última ocorrência registrada",
          "maxLength": 240
        },
        "lastSeverity": {
          "type": "string",
          "enum": ["nenhuma", "baixa", "media", "urgente"],
          "description": "Gravidade da última ocorrência"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização"
        }
      },
      "required": [
        "ownerId",
        "name",
        "crop",
        "sector",
        "status",
        "latitude",
        "longitude",
        "lastReportSummary",
        "lastSeverity",
        "createdAt",
        "updatedAt"
      ]
    },
    "FieldReport": {
      "title": "FieldReport",
      "description": "Relato de campo transcrito por voz ou editado no celular com praga, tratamento atual e solução recomendada.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do produtor proprietário",
          "maxLength": 128
        },
        "microareaId": {
          "type": "string",
          "description": "ID da microárea associada",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "microareaName": {
          "type": "string",
          "description": "Nome da microárea no momento do relato",
          "minLength": 2,
          "maxLength": 80
        },
        "crop": {
          "type": "string",
          "description": "Hortaliça afetada",
          "minLength": 2,
          "maxLength": 50
        },
        "transcript": {
          "type": "string",
          "description": "Texto transcrito da gravação de voz",
          "minLength": 3,
          "maxLength": 1000
        },
        "pestProblem": {
          "type": "string",
          "description": "Praga ou doença identificada na lavoura",
          "minLength": 2,
          "maxLength": 160
        },
        "pestCount": {
          "type": "string",
          "description": "Contagem de insetos ou nível de intensidade observada",
          "minLength": 2,
          "maxLength": 120
        },
        "currentTreatment": {
          "type": "string",
          "description": "Como a ocorrência está sendo combatida atualmente",
          "minLength": 2,
          "maxLength": 200
        },
        "treatmentEfficiency": {
          "type": "string",
          "enum": ["eficiente", "parcial", "ineficiente"],
          "description": "Eficiência percebida do combate atual"
        },
        "recommendedSolution": {
          "type": "string",
          "description": "Solução ou ação recomendada para melhoria",
          "minLength": 2,
          "maxLength": 240
        },
        "severity": {
          "type": "string",
          "enum": ["baixa", "media", "urgente"],
          "description": "Severidade classificada automaticamente"
        },
        "category": {
          "type": "string",
          "enum": ["praga", "doenca", "irrigacao", "clima", "nutricao", "geral"],
          "description": "Categoria agronômica identificada"
        },
        "detectedKeywords": {
          "type": "array",
          "description": "Palavras-chave detectadas na fala"
        },
        "latitude": {
          "type": "number",
          "description": "Latitude GPS capturada em campo"
        },
        "longitude": {
          "type": "number",
          "description": "Longitude GPS capturada em campo"
        },
        "resolved": {
          "type": "boolean",
          "description": "Indica se a ocorrência já foi tratada"
        },
        "seasonMonth": {
          "type": "string",
          "description": "Mês de referência para análise de sazonalidade (AAAA-MM)",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data do registro no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização"
        }
      },
      "required": [
        "ownerId",
        "microareaId",
        "microareaName",
        "crop",
        "transcript",
        "pestProblem",
        "pestCount",
        "currentTreatment",
        "treatmentEfficiency",
        "recommendedSolution",
        "severity",
        "category",
        "detectedKeywords",
        "latitude",
        "longitude",
        "resolved",
        "seasonMonth",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/ProducerProfile" },
      "description": "Perfil privado do produtor rural"
    },
    "/microareas/{microareaId}": {
      "schema": { "$ref": "#/entities/Microarea" },
      "description": "Microáreas (canteiros e estufas) cadastradas pelo produtor"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/FieldReport" },
      "description": "Relatos de campo transcritos por voz com praga, tratamento atual e solução"
    }
  }
}
